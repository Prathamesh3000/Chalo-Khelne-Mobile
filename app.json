{
  "expo": {
    "name": "chalo-khelne",
    "slug": "chalo-khelne",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/brand-1024.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "chalokhelne",
    "splash": {
      "image": "./assets/brand-1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f4511e"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chalo Khelne to access your photos so you can set a profile picture, add images to posts, and attach payment screenshots.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.943646523727-a4cc9tk338qedpa4pn7ehc8v8dbs39al"
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "@sentry/react-native"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.chalokhelnesport.client",
      "icon": "./assets/app-icon-1024.png",
      "infoPlist": {
        "CFBundleDisplayName": "Chalo Khelne",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Chalo Khelne uses your local network to connect to nearby devices on the same Wi-Fi when you are testing an internal build. The App Store version connects over the internet.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSFaceIDUsageDescription": "Allow Chalo Khelne to use Face ID to protect your saved sign-in credentials."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "chalokhelne"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "package": "com.chalokhelnesport.client"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "36367fcb-9494-4782-bc95-c84b440cb9fd"
      }
    },
    "owner": "prathameshdhanawate",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/36367fcb-9494-4782-bc95-c84b440cb9fd"
    }
  }
}
