{
    "cli": {
        "version": ">= 3.0.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "credentialsSource": "local"
            },
            "ios": {
                "simulator": true
            },
            "channel": "development",
            "env": {
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "local": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": true
            },
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_ENV": "development",
                "EXPO_PUBLIC_SERVER_URL": "http://192.168.1.87:3003",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "preview": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": false
            },
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_ENV": "production",
                "EXPO_PUBLIC_SERVER_URL": "https://chalokhelne.com",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        },
        "production": {
            "android": {
                "buildType": "app-bundle",
                "autoIncrement": true
            },
            "ios": {
                "autoIncrement": true
            },
            "channel": "production",
            "env": {
                "EXPO_PUBLIC_ENV": "production",
                "EXPO_PUBLIC_SERVER_URL": "https://chalokhelne.com",
                "SENTRY_DISABLE_AUTO_UPLOAD": "true"
            }
        }
    },
    "submit": {
        "production": {
            "ios": {
                "appleId": "REPLACE-WITH-APPLE-ID-EMAIL",
                "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID",
                "appleTeamId": "REPLACE-WITH-APPLE-TEAM-ID"
            }
        }
    }
}
